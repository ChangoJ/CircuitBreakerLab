COMPOSE_PROJECT_NAME=circuit-breaker-lab
IMAGE_TAG=dev
DOTNET_VERSION=10.0
ASPNETCORE_ENVIRONMENT=Development
CONTAINER_PORT=8080

API_PORT=5080
SIMULATOR_PORT=5090

PROVIDER_BASE_URL=http://simulator:8080
PROVIDER_TIMEOUT_SECONDS=2

CB_FAILURE_RATIO=0.5
CB_MINIMUM_THROUGHPUT=4
CB_SAMPLING_DURATION_SECONDS=30
CB_BREAK_DURATION_SECONDS=15
CB_EVENT_HISTORY_SIZE=50

SIMULATOR_DEFAULT_MODE=Healthy
SIMULATOR_DEFAULT_FAILURE_RATE=0.5
SIMULATOR_DEFAULT_LATENCY_MS=5000
